# ==============================================================================
# 셜록-알람 (Sherlock-Alarm) 환경변수 통합 명세서 (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 백엔드 전용 환경변수 (Backend Settings -> .env)
# ------------------------------------------------------------------------------

# [필수] 셜록홈즈 대상 지점 예약 페이지 URL (충청 대전 세종 - 아산점 기본값)
SHERLOCK_URL=https://sherlock-holmes.co.kr/reservation/index.php?sido=12&bno=86#reservation

# [필수] Pushover API 인증 정보
# - PUSHOVER_API_TOKEN: Pushover 가입 후 생성된 애플리케이션 토큰
# - PUSHOVER_USER_KEY: 사용자 유저 키 (여러 명 전송 시 콤마(,)로 구분: KEY_1,KEY_2)
PUSHOVER_API_TOKEN=your_pushover_application_token_here
PUSHOVER_USER_KEY=your_pushover_user_key_here

# [선택] Pushover 알림 상황별 5종 전용 애플리케이션 토큰 (미설정 시 PUSHOVER_API_TOKEN으로 폴백)
# PUSHOVER_TOKEN_EMERGENCY=your_emergency_app_token_here
# PUSHOVER_TOKEN_BRIEFING=your_briefing_app_token_here
# PUSHOVER_TOKEN_DIFF_PLUS=your_diff_plus_app_token_here
# PUSHOVER_TOKEN_DIFF_MINUS=your_diff_minus_app_token_here
# PUSHOVER_TOKEN_END=your_end_app_token_here

# [선택] Pushover 사용자별 사운드 지정 (콤마 구분: vibrate,maple)
# PUSHOVER_SOUND=vibrate,maple


# [선택] Pushover 재시도 간격 및 만료 시간 (단위: 초)
# [중요] PUSHOVER_EXPIRE는 감시 주기(10분=600초)보다 짧아야 중복 알람 겹침이 방지됩니다. (기본값: 300초 = 5분)
# PUSHOVER_RETRY=60
# PUSHOVER_EXPIRE=300

# [선택] 감시 조기 출근 예약 시간대 상한선 (기본값: 12:00)
# EARLY_THRESHOLD_LIMIT=12:00

# [선택] 조기 출근 긴급 알람 발생 시 동적 출근 시각 (기본값: 11:00)
# EARLY_SHIFT_START_TIME=11:00

# [선택] 오전 감시 시작 시각 (기본값: 09:40)
# MONITOR_START_TIME=09:40

# [선택] Upstash Redis REST API 자격 증명 (경량 DB 상태 저장 및 Smart Silence용)
# UPSTASH_REDIS_REST_URL=https://your-redis-name.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here


# ------------------------------------------------------------------------------
# 2. 프론트엔드 전용 환경변수 (Frontend Settings -> .env.local)
# ------------------------------------------------------------------------------
# 향후 웹 제어판(PWA) 구축 시 사용할 프론트엔드 공개 환경변수 템플릿입니다.
# NEXT_PUBLIC_API_URL=https://api.example.com
