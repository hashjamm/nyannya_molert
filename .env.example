# 셜록홈즈 대상 지점 예약 페이지 URL (충청 대전 세종 - 아산점 기본값)
SHERLOCK_URL=https://sherlock-holmes.co.kr/reservation/index.php?sido=12&bno=86#reservation

# Pushover API 인증 정보 (Pushover 가입 후 생성된 토큰 및 유저 키 입력)
PUSHOVER_API_TOKEN=your_pushover_application_token_here
PUSHOVER_USER_KEY=your_pushover_user_key_here

# 감시할 조기 출근 예약 시간대 상한선 (HH:MM 형식)
# 이 시간보다 이른 예약 완료(불가) 타임이 존재할 시 긴급 알림을 보냅니다.
EARLY_THRESHOLD_LIMIT=12:00

# Pushover 알람 세부 설정 (오버라이드용 선택 사항 - 기본값: siren / 60초 / 3600초)
# PUSHOVER_SOUND=vibrate
# PUSHOVER_RETRY=60

# Pushover 알람 만료 시간 (단위: 초)
# [중요] 사용자가 알림을 확인하지 않아 알람이 지속되는 상태에서 다음 10분 주기 감시가 실행되면 
# 알람이 중복으로 울려 겹치게 됩니다. 이를 방지하려면 PUSHOVER_EXPIRE(만료 시간)를 
# 반드시 감시 주기인 10분(600초)보다 짧게 설정해야 합니다. (기본 추천: 300초 = 5분)
# PUSHOVER_EXPIRE=300

